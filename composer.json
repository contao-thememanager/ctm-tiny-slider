{
  "name": "contao-thememanager/ctm-tiny-slider",
  "type": "contao-bundle",
  "description": "Tiny Slider integration for Contao Theme-Manager",
  "keywords": ["slider", "theme"],
  "homepage": "https://www.contao-thememanager.com/",
  "authors": [
    {
      "name": "Oveleon",
      "homepage": "https://oveleon.de/",
      "role": "Developer"
    },
    {
      "name": "Daniele Sciannimanica",
      "homepage": "https://github.com/doishub",
      "role": "Developer"
    },
    {
      "name": "Sebastian Zoglowek",
      "homepage": "https://github.com/zoglo",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.1",
    "contao/core-bundle": "^5.3",
    "contao-thememanager/core": "^2.3"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.3.1"
  },
  "conflict": {
    "contao/manager-plugin": "<2.0 || >=3.0"
  },
  "autoload": {
    "psr-4": {
      "ContaoThemeManager\\TinySlider\\": "src/"
    },
    "classmap": [
      "contao/"
    ],
    "exclude-from-classmap": [
      "contao/config/",
      "contao/languages/",
      "contao/templates/"
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-main": "2.3.x-dev"
    },
    "contao-manager-plugin": "ContaoThemeManager\\TinySlider\\ContaoManager\\Plugin"
  }
}
